{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switch Library",
  "version": "0.1.0",
  "identifier": "com.nxstore.switchlibrary",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Switch Library",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "theme": "Dark",
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Switch catalog browser and collection tracker"
  }
}
